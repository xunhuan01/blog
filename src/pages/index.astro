---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Datetime from "@/components/Datetime.astro";
import ChatHall from "@/components/ChatHall.astro";
import PurchaseTiers from "@/components/PurchaseTiers.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// 首页文章
const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const pinned = sortedPosts.filter(p => p.data.featured);
const rest = sortedPosts.filter(p => !p.data.featured);
const displayPosts = [...pinned, ...rest];
const homePath = getRelativeLocaleUrl(locale, "");

// 分类标签文章
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const sortedAllPosts = getSortedPosts(allPosts);
const tags = getUniqueTags(allPosts);
// 皮条往事置顶，其余标签保持原顺序
const sortedTags = [
  ...tags.filter(t => t.tagName === "皮条往事"),
  ...tags.filter(t => t.tagName !== "皮条往事"),
];

// 2026-10-19 用户要求：去掉列表上方那行「#皮条往事（9篇）」，把篇数直接并进每个标签按钮。
// 口径与筛选逻辑一致：普通标签 = 带该标签的文章数；「往期」= 全部文章里不含「小说」的（小说只能在小说标签里看）。
const tagCount = (name) =>
  name === "往期"
    ? sortedAllPosts.filter(p => !(p.data.tags || []).includes("小说")).length
    : sortedAllPosts.filter(p => (p.data.tags || []).includes(name)).length;

// 摘要：取正文开头一段，交给 CSS 收成整两行（2026-10-18 用户要求：不要自动生成的 description）
// 2026-10-18 傍晚（用户：列表里摘要只写了一行半就被截断，要写满两行）：
//   原来只取 60 字 —— 390px 窄屏够两行，容器一宽就只剩一行半，且截断处没有省略号。
//   现在取 120 字：任何宽度下都长过两行，由 CSS 的 -webkit-line-clamp:2 统一收成整两行；
//   正文本身不足两行的，按原样显示（截断时才补一个省略号）。
function makeExcerpt(raw) {
  const EXCERPT_CHARS = 120; // 放在函数内：Card.astro 里 makeExcerpt 的调用早于本文件的模块级声明，放外面会 TDZ 报错
  const plain = String(raw || "")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/^#{1,6}\s+/gm, "")
    .replace(/^\s*[-*+]\s+/gm, "")
    .replace(/^\s*>\s?/gm, "")
    .replace(/[*_~`]/g, "")
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
  if (!plain) return "";
  if (plain.length <= EXCERPT_CHARS) return plain;
  return plain.slice(0, EXCERPT_CHARS) + "…";
}
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <!-- 分类面板 -->
    <section id="tags-panel" class="pt-2 pb-5" style="display:block">
      <div class="sm:flex sm:gap-8 mt-0">
        <div class="hidden sm:block sm:w-36 shrink-0">
          <ul class="flex flex-col gap-1" id="tag-list">
            {sortedTags.map(({ tag, tagName }) => (
              <li>
                <button data-tag={tagName} class="tag-btn text-left w-full text-sm py-1 px-2 rounded hover:bg-accent/10 transition-colors text-foreground/70">#{tagName}（{tagCount(tagName)}篇）</button>
              </li>
            ))}
            <li>
              <button data-tag="往期" class="tag-btn text-left w-full text-sm py-1 px-2 rounded hover:bg-accent/10 transition-colors text-foreground/70">📚 往期（{tagCount("往期")}篇）</button>
            </li>
          </ul>
        </div>
        <!-- 手机端: 左下浮动标签丸 (方案C-改②: 滚动时自动隐走, 停下0.45s滑回) -->
        <div id="tag-dock" class="sm:hidden fixed left-3 bottom-16 z-40 flex flex-col items-start gap-1.5">
          {sortedTags.map(({ tag, tagName }) => (
            <button data-tag={tagName} class="tag-btn text-left text-sm py-1.5 px-3 rounded-full bg-background/95 border border-border shadow-sm backdrop-blur-sm text-foreground/70">#{tagName}（{tagCount(tagName)}篇）</button>
          ))}
          <button data-tag="往期" class="tag-btn text-left text-sm py-1.5 px-3 rounded-full bg-background/95 border border-border shadow-sm backdrop-blur-sm text-foreground/70">📚 往期（{tagCount("往期")}篇）</button>
        </div>
        <div class="sm:flex-1 min-w-0" id="article-list">
          {/* 2026-10-19：这行「#皮条往事（9篇）」已取消，篇数并进上面的标签按钮 */}
          <ul class="flex flex-col gap-3">
            {sortedAllPosts.map(({ id, data, filePath, body }) => {
              const { title, tags: postTags, password, ...rest } = data;
              const postUrl = getPostUrl(id, filePath, locale);
              const isLocked = typeof password === "string" && password.length > 0;
              const excerpt = makeExcerpt(body) || data.description || "";
              return (
                                <li class="article-item post-item" data-tags={(postTags || []).join(",")}>
                  <a href={postUrl} data-astro-prefetch="viewport" class="post-card">
                    <div class="post-card__head">
                      <h3 class="post-card__title">{title}</h3>
                      {isLocked && <span class="chip chip--member">会员</span>}
                      <span class="post-card__date"><Datetime {...rest} /></span>
                    </div>
                    <p class="post-card__ex">{excerpt}</p>
                    <div class="post-card__meta">
                      {postTags && postTags[0] && <span class="post-card__cat">{postTags[0]}</span>}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </section>

    <!-- 聊天面板（大厅） -->
    <section id="chat-panel" class="pt-6 pb-6" style="display:none">
      <ChatHall />
    </section>

    <!-- 购买面板（与 /purchase/ 独立页共用 PurchaseTiers 组件） -->
    <section id="purchase-panel" class="pt-2 pb-6" style="display:none">
      <div style="max-width:420px;margin:0 auto">
        <PurchaseTiers />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  function initApp() {
    // 标签筛选逻辑
    const tagBtns = document.querySelectorAll(".tag-btn");
    const articles = document.querySelectorAll(".article-item");
    // 2026-10-19：列表上方那行「#皮条往事（9篇）」已取消（篇数并进标签按钮），这里不再引用它
    if (tagBtns.length && articles.length) {
      tagBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          const tag = btn.dataset.tag;
          // 同步高亮: 桌面标签列与手机浮动丸里 data-tag 相同的按钮一起点亮（蓝底白字）
          tagBtns.forEach(b => {
            b.classList.toggle("tag-active", b.dataset.tag === tag);
          });
          articles.forEach(article => {
            const articleTags = article.dataset.tags;
            if (tag === "往期") {
              // 往期 = 全部文章，但隐藏小说（小说只能在小说标签里看）
              const isNovel = articleTags.includes("小说");
              article.style.display = isNovel ? "none" : "block";
            } else if (articleTags.includes(tag)) {
              article.style.display = "block";
            } else {
              article.style.display = "none";
            }
          });
          // 记住当前选中的标签：从文章返回首页时恢复用（2026-09-06 用户要求）
          try { sessionStorage.setItem("lastTag", tag); } catch (_) {}
          // 首页金色置顶按钮已按用户要求移除（2026-09-21）：通往性自由之路只在购买页保留入口，列表页不再出现
        });
      });
      // 选中顺序：URL ?tag= 参数 > 上次选中的标签（从文章返回时保留）> 默认皮条往事
      const urlTag = new URLSearchParams(window.location.search).get("tag");
      let lastTag = null;
      try { lastTag = sessionStorage.getItem("lastTag"); } catch (_) {}
      const targetTag = urlTag || lastTag || "皮条往事";
      const targetBtn = document.querySelector(`[data-tag="${targetTag}"]`);
      if (targetBtn) targetBtn.click();
      else document.querySelector('[data-tag="皮条往事"]')?.click();
    }
    // 浮动标签丸: 滚动时隐走, 停止 450ms 后滑回 (只绑一次)
    const dock = document.getElementById("tag-dock");
    if (dock && !window.__dockScrollBound) {
      window.__dockScrollBound = true;
      let dockTimer;
      const hideDock = () => {
        dock.classList.add("dock-hide");
        clearTimeout(dockTimer);
        dockTimer = setTimeout(() => dock.classList.remove("dock-hide"), 450);
      };
      window.addEventListener("scroll", hideDock, { passive: true });
      // 手机端首页改由 #page-shell 承担滚动（App 式外壳，见文件末尾样式），它滚也要收起标签丸
      const shell = document.getElementById("page-shell");
      if (shell) shell.addEventListener("scroll", hideDock, { passive: true });
    }
  }
  initApp();
  document.addEventListener("astro:page-load", initApp);
</script>

<style is:global>
  /* 手机端首页 = App 式外壳（2026-09-26）
     问题：底栏【文章/聊天/购买】切换时整页“往下沉”一下。
     成因：文章列表面板很长、聊天/购买只有一屏 → 切面板时窗口滚动位置和文档高度突变
           → 手机地址栏跟着收/放 → 固定在底部的三栏跟着挪一下。
     做法：只在手机端把窗口的滚动彻底关掉，让 #main-content 自己滚。
           这样切面板时窗口 scrollY 恒为 0、文档高度恒定，浏览器没理由动，三栏纹丝不动。
     兼容：:has() 不支持的老浏览器自动退回原来的整页滚动方式，不会更差。 */
  @media (max-width: 639px) {
    html:has(#chat-panel) { height: 100svh; overflow: hidden; }
    body:has(#chat-panel) { height: 100svh; min-height: 0; overflow: hidden; }
    /* 内容外壳（Layout 里包住 <slot/> 的那层 #page-shell）接管滚动：
       它本来就有 flex-1 + pb-16（给底部导航留位），这里只加 min-height:0 + overflow-y:auto */
    body:has(#chat-panel) > #page-shell {
      min-height: 0; overflow-y: auto; overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }
  }
</style>
