---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Datetime from "@/components/Datetime.astro";
import ChatHall from "@/components/ChatHall.astro";
import PurchaseTiers from "@/components/PurchaseTiers.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const homePath = getRelativeLocaleUrl(locale, "");

// 分类标签文章
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
// getSortedPosts 会把带 order（或标题里带「（一）（二）」）的文章排在最前 —— 皮条生涯 1/2/3。
// 2026-11-01 用户要求：这个「置顶」只在「皮条往事」标签下生效；切到「全部」就按正常时间排。
// 所以这里另算一份纯时间序给服务端渲染，点「皮条往事」时再由前端把 order 文章挪到最前。
const sortedAllPosts = getSortedPosts(allPosts);
const tsOf = (p) => Math.floor(new Date(p.data.modDatetime ?? p.data.pubDatetime).getTime() / 1000);
const orderOf = (p) => {
  if (typeof p.data.order === "number") return p.data.order;
  const m = /[（(]\s*(\d{1,2}|[一二三四五六七八九十])\s*[)）]/.exec(String(p.data.title || ""));
  if (!m) return null;
  const CN = { 一: 1, 二: 2, 三: 3, 四: 4, 五: 5, 六: 6, 七: 7, 八: 8, 九: 9, 十: 10 };
  return /^\d+$/.test(m[1]) ? Number(m[1]) : (CN[m[1]] ?? null);
};
const sortedByTime = [...sortedAllPosts].sort((a, b) => tsOf(b) - tsOf(a));
const tags = getUniqueTags(allPosts);
// 皮条往事置顶，其余标签保持原顺序
const sortedTags = [
  ...tags.filter(t => t.tagName === "皮条往事"),
  ...tags.filter(t => t.tagName !== "皮条往事"),
];

// 2026-10-19 用户要求：去掉列表上方那行「#皮条往事（9篇）」，把篇数直接并进每个标签按钮。
// 口径与筛选逻辑一致：普通标签 = 带该标签的文章数；「往期」= 全部文章里不含「小说」的（小说只能在小说标签里看）。
// 2026-11-01 用户要求：原来的「往期」改名「全部」，并提到标签列最前。
// 语义不变：「全部」= 除「小说」以外的所有文章（小说仍只在小说标签里看）。
// 旧链接 ?tag=往期 继续可用。
const isAllTag = (name) => name === "全部" || name === "往期";
const tagCount = (name) =>
  isAllTag(name)
    ? sortedAllPosts.filter(p => !(p.data.tags || []).includes("小说")).length
    : sortedAllPosts.filter(p => (p.data.tags || []).includes(name)).length;

// 摘要：取正文开头一段，交给 CSS 收成整两行（2026-10-18 用户要求：不要自动生成的 description）
// 2026-10-18 傍晚（用户：列表里摘要只写了一行半就被截断，要写满两行）：
//   原来只取 60 字 —— 390px 窄屏够两行，容器一宽就只剩一行半，且截断处没有省略号。
//   现在取 120 字：任何宽度下都长过两行，由 CSS 的 -webkit-line-clamp:2 统一收成整两行；
//   正文本身不足两行的，按原样显示（截断时才补一个省略号）。
function makeExcerpt(raw) {
  const EXCERPT_CHARS = 120; // 放在函数内：Card.astro 里 makeExcerpt 的调用早于本文件的模块级声明，放外面会 TDZ 报错
  const plain = String(raw || "")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/^#{1,6}\s+/gm, "")
    .replace(/^\s*[-*+]\s+/gm, "")
    .replace(/^\s*>\s?/gm, "")
    .replace(/[*_~`]/g, "")
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
  if (!plain) return "";
  if (plain.length <= EXCERPT_CHARS) return plain;
  return plain.slice(0, EXCERPT_CHARS) + "…";
}
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <!-- 分类面板 -->
    <section id="tags-panel" class="pt-2 pb-5" style="display:block">
      <div class="sm:flex sm:gap-8 mt-0">
        <div class="hidden sm:block sm:w-36 shrink-0">
          <ul class="flex flex-col gap-1" id="tag-list">
            {/* 2026-11-01：全部置顶（原「往期」排在最后） */}
            <li>
              <button data-tag="全部" class="tag-btn text-left w-full text-sm py-1 px-2 rounded hover:bg-accent/10 transition-colors text-foreground/70">全部（{tagCount("全部")}篇）</button>
            </li>
            {sortedTags.map(({ tag, tagName }) => (
              <li>
                <button data-tag={tagName} class="tag-btn text-left w-full text-sm py-1 px-2 rounded hover:bg-accent/10 transition-colors text-foreground/70">#{tagName}（{tagCount(tagName)}篇）</button>
              </li>
            ))}
          </ul>
        </div>
        <!-- 手机端：右下角标签球（2026-10-19 用户指定）
             一颗球 → 点开向上展开带篇数的标签 → 一滚就缩回球。
             按钮仍带 .tag-btn + data-tag，所以原来的筛选/高亮逻辑一行不用改。 -->
        <div id="tag-dock" class="sm:hidden dock-closed">
          <div id="tag-pills" class="dock-pills">
            {/* 2026-11-01：全部置顶（原「往期」排在最后） */}
            <button data-tag="全部" class="tag-btn dock-pill">全部<i class="dock-n">{tagCount("全部")}</i></button>
            {sortedTags.map(({ tag, tagName }) => (
              <button data-tag={tagName} class="tag-btn dock-pill">#{tagName}<i class="dock-n">{tagCount(tagName)}</i></button>
            ))}
          </div>
          <button id="dock-ball" class="dock-ball" type="button" aria-label="切换分类">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          </button>
        </div>
        <div class="sm:flex-1 min-w-0" id="article-list">
          {/* 2026-10-19：这行「#皮条往事（9篇）」已取消，篇数并进上面的标签按钮 */}
          <ul class="flex flex-col gap-3">
            {sortedByTime.map(({ id, data, filePath, body }) => {
              const { title, tags: postTags, password, ...rest } = data;
              const postUrl = getPostUrl(id, filePath, locale);
              const isLocked = typeof password === "string" && password.length > 0;
              const excerpt = makeExcerpt(body) || data.description || "";
              return (
                                <li class="article-item post-item" data-tags={(postTags || []).join(",")} data-order={orderOf({ data }) ?? ""} data-ts={tsOf({ data })}>
                  <a href={postUrl} data-astro-prefetch="viewport" class="post-card">
                    <div class="post-card__head">
                      <h3 class="post-card__title">{title}</h3>
                      {isLocked && <span class="chip chip--member">会员</span>}
                      <span class="post-card__date"><Datetime {...rest} /></span>
                    </div>
                    <p class="post-card__ex">{excerpt}</p>
                    <div class="post-card__meta">
                      {postTags && postTags[0] && <span class="post-card__cat">{postTags[0]}</span>}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </section>

    <!-- 聊天面板（大厅） -->
    <section id="chat-panel" class="pt-6 pb-6" style="display:none">
      <ChatHall />
    </section>

    <!-- 购买面板（与 /purchase/ 独立页共用 PurchaseTiers 组件） -->
    <section id="purchase-panel" class="pt-2 pb-6" style="display:none">
      <div style="max-width:420px;margin:0 auto">
        <PurchaseTiers />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  function initApp() {
    // 标签筛选逻辑
    const tagBtns = document.querySelectorAll(".tag-btn");
    const articles = document.querySelectorAll(".article-item");
    // 2026-10-19：列表上方那行「#皮条往事（9篇）」已取消（篇数并进标签按钮），这里不再引用它
    if (tagBtns.length && articles.length) {
      // 2026-11-01：列表有两种顺序 ——
      //   皮条往事：带 order 的系列文章（皮条生涯 1·2·3）排最前，其余按时间倒序；
      //   其它标签（含「全部」）：一律按发布时间倒序，不做任何置顶。
      const listEl = document.querySelector("#article-list ul");
      const reorderList = (pinFirst) => {
        if (!listEl) return;
        const items = [...listEl.children];
        const ord = (el) => (el.dataset.order ? Number(el.dataset.order) : Infinity);
        const ts = (el) => Number(el.dataset.ts || 0);
        items.sort((a, b) => {
          if (pinFirst) {
            const oa = ord(a), ob = ord(b);
            if (oa !== ob) return oa - ob;
          }
          return ts(b) - ts(a);
        });
        items.forEach(el => listEl.appendChild(el));
      };
      tagBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          const tag = btn.dataset.tag;
          // 同步高亮: 桌面标签列与手机浮动丸里 data-tag 相同的按钮一起点亮（蓝底白字）
          tagBtns.forEach(b => {
            b.classList.toggle("tag-active", b.dataset.tag === tag);
          });
          articles.forEach(article => {
            const articleTags = article.dataset.tags;
            if (tag === "全部" || tag === "往期") {
              // 全部 = 除「小说」外的所有文章（小说只能在小说标签里看）
              const isNovel = articleTags.includes("小说");
              article.style.display = isNovel ? "none" : "block";
            } else if (articleTags.includes(tag)) {
              article.style.display = "block";
            } else {
              article.style.display = "none";
            }
          });
          // 2026-11-01：只有「皮条往事」把系列文章排最前，其余按时间倒序
          reorderList(tag === "皮条往事");
          // 记住当前选中的标签：从文章返回首页时恢复用（2026-09-06 用户要求）
          try { sessionStorage.setItem("lastTag", tag); } catch (_) {}
          // 首页金色置顶按钮已按用户要求移除（2026-09-21）：通往性自由之路只在购买页保留入口，列表页不再出现
        });
      });
      // 页面加载时的默认选中（2026-11-01 用户要求）
      //   优先顺序：URL ?tag= 参数（从标签页跳来）
      //            > 从文章内页返回首页 → 恢复刚才选的标签
      //            > 首次访客「皮条往事」 > 其余「全部」
      //
      // 两个坑（都实测翻过车，别删）：
      // ① initApp 在首次加载会跑两次（末尾直接调一次 + ClientRouter 的 astro:page-load 又一次）。
      //    所以这里用「这个 URL 只应用一次」的守卫挡住第二次 —— 否则第二次会把刚从文章恢复出来的
      //    标签覆盖成默认值。
      // ② visited 标记必须延后写，否则第二次调用就读到 "1"，把首次访客也判成回访，皮条往事永远出不来。
      const normTag = (v) => (v === "往期" ? "全部" : v); // 兼容改名前的老链接
      // 守卫用「页面上还没有高亮」判断，而不是比较 URL —— 浏览器后退回到同一个 URL 时，
      // URL 比较会把这次导航误判成「已经处理过」，结果首页既不高亮也不筛选（2026-11-01 实测）。
      if (!document.querySelector(".tag-active")) {
        const urlTag = normTag(new URLSearchParams(window.location.search).get("tag"));
        let seen = false;
        try { seen = localStorage.getItem("waiwei:visited") === "1"; } catch (_) {}
        // 从文章内页返回：Layout 会在文章页写下 __fromPost，这里消费掉并还原上次选的标签
        let restoreTag = null;
        try {
          if (sessionStorage.getItem("__fromPost") === "1") {
            restoreTag = normTag(sessionStorage.getItem("lastTag"));
            sessionStorage.removeItem("__fromPost");
          }
        } catch (_) {}
        const targetTag = urlTag || restoreTag || (seen ? "全部" : "皮条往事");
        if (!seen && !window.__visitMarkQueued) {
          window.__visitMarkQueued = true;
          setTimeout(() => { try { localStorage.setItem("waiwei:visited", "1"); } catch (_) {} }, 1200);
        }
        const targetBtn = document.querySelector(`[data-tag="${targetTag}"]`);
        if (targetBtn) targetBtn.click();
        else document.querySelector('[data-tag="皮条往事"]')?.click();
      }
    }
    // ── 右下角标签球（2026-10-19）：默认只有一颗球；点球展开竖排标签；一滚就缩回球 ──
    // 守卫必须挂在**球元素自己**身上，不能挂 window：从文章页返回首页时 ClientRouter 会把整块
    // DOM 换掉，#tag-dock 是全新元素，而 window.__dockBound 仍是 true → 事件永远绑不上，
    // 球点不开（2026-11-01 用户实测到；改前用的是 window 全局标记）。
    const dock = document.getElementById("tag-dock");
    const ball = document.getElementById("dock-ball");
    if (dock && ball && !ball.dataset.dockBound) {
      ball.dataset.dockBound = "1";
      const closeDock = () => {
        dock.classList.add("dock-closed");
        dock.classList.remove("dock-open");
      };
      const openDock = () => {
        dock.classList.remove("dock-closed");
        dock.classList.add("dock-open");
      };
      ball.addEventListener("click", (e) => {
        e.stopPropagation();
        if (dock.classList.contains("dock-open")) closeDock();
        else openDock();
      });
      // 选完任何一颗（手机球里的、桌面那列的）都收起
      dock.querySelectorAll(".tag-btn").forEach(b => b.addEventListener("click", closeDock));
      // 点页面其它地方也收起。document/window 上的监听不会随 DOM 重建而消失，每重建一次就多一条，
      // 用 isConnected 让指向旧元素的那几条自动变成空操作（否则旧 dock 的 closeDock 会乱跑）。
      document.addEventListener("click", (e) => { if (dock.isConnected && !dock.contains(e.target)) closeDock(); });
      // 一滚就缩回球（小球本身不消失）
      const onScroll = () => { if (dock.isConnected && dock.classList.contains("dock-open")) closeDock(); };
      window.addEventListener("scroll", onScroll, { passive: true });
      const shell = document.getElementById("page-shell");
      if (shell) shell.addEventListener("scroll", onScroll, { passive: true });
      closeDock();
    }
  }
  initApp();
  document.addEventListener("astro:page-load", initApp);
</script>

<style is:global>
  /* 手机端首页 = App 式外壳（2026-09-26）
     问题：底栏【文章/聊天/购买】切换时整页“往下沉”一下。
     成因：文章列表面板很长、聊天/购买只有一屏 → 切面板时窗口滚动位置和文档高度突变
           → 手机地址栏跟着收/放 → 固定在底部的三栏跟着挪一下。
     做法：只在手机端把窗口的滚动彻底关掉，让 #main-content 自己滚。
           这样切面板时窗口 scrollY 恒为 0、文档高度恒定，浏览器没理由动，三栏纹丝不动。
     兼容：:has() 不支持的老浏览器自动退回原来的整页滚动方式，不会更差。 */
  @media (max-width: 639px) {
    html:has(#chat-panel) { height: 100svh; overflow: hidden; }
    body:has(#chat-panel) { height: 100svh; min-height: 0; overflow: hidden; }
    /* 内容外壳（Layout 里包住 <slot/> 的那层 #page-shell）接管滚动：
       它本来就有 flex-1 + pb-16（给底部导航留位），这里只加 min-height:0 + overflow-y:auto */
    body:has(#chat-panel) > #page-shell {
      min-height: 0; overflow-y: auto; overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }
  }
</style>
