---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath, body } = Astro.props;

const { title, description, tags, featured, password, ...props } = data;
const category = tags?.[0] || "";
const postUrl = getPostUrl(id, filePath, Astro.currentLocale);
const excerpt = makeExcerpt(body) || description || "";

// 摘要：取正文开头一段，交给 CSS 收成整两行（2026-10-18 用户要求：不要自动生成的 description）
// 2026-10-18 傍晚（用户：列表里摘要只写了一行半就被截断，要写满两行）：
//   原来只取 60 字 —— 390px 窄屏够两行，容器一宽就只剩一行半，且截断处没有省略号。
//   现在取 120 字：任何宽度下都长过两行，由 CSS 的 -webkit-line-clamp:2 统一收成整两行；
//   正文本身不足两行的，按原样显示（截断时才补一个省略号）。
function makeExcerpt(raw) {
  const EXCERPT_CHARS = 120; // 放在函数内：Card.astro 里 makeExcerpt 的调用早于本文件的模块级声明，放外面会 TDZ 报错
  const plain = String(raw || "")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/^#{1,6}\s+/gm, "")
    .replace(/^\s*[-*+]\s+/gm, "")
    .replace(/^\s*>\s?/gm, "")
    .replace(/[*_~`]/g, "")
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
  if (!plain) return "";
  if (plain.length <= EXCERPT_CHARS) return plain;
  return plain.slice(0, EXCERPT_CHARS) + "…";
}
---

<li class="post-item">
  <a href={postUrl} data-astro-prefetch="viewport" class="post-card">
    <div class="post-card__head">
      <Heading transition:name={toTransitionName(title)} class="post-card__title">
        {title}
      </Heading>
      {password && <span class="chip chip--member">会员</span>}
      <span class="post-card__date">
        <Datetime {...props} />
      </span>
    </div>

    {description && <p class="post-card__ex">{excerpt}</p>}

    <div class="post-card__meta">
      {featured && <span class="chip chip--pin">置顶</span>}
      {category && <span class="post-card__cat">{category}</span>}
    </div>
  </a>
</li>
