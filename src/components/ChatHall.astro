---
// 聊天大厅（2026-09-21 改版：资源墙做成约 1/3 屏的大卡片，下面两张并排小卡，整体不再是一排同样的列表）
const HALL = {
  wall: "https://chat.waiwei.top/posts",
  member: "https://chat.waiwei.top/member",
  // 线路一 = 上海阿里云 IP 直连（大陆 0.1 秒级，2026-09-26 上线）；线路二 = 东京（原线路，兜底）
  chat1: "https://139.224.1.54:9443/",
  chat: "https://chat.waiwei.top/",
};

// 资源墙「最近更新」：构建时先抓一次接口，把最近 3 条直接写进 HTML（2026-10-04 用户要求：
// 不论新访客/老访客/弱网都必须看到更新提示，让客户知道这个频道一直在更新）
// 兜底：构建时抓不到（CF 构建机连不上 / 接口抖动）就用下面这份写死的快照，页面永远不为空
const FALLBACK_UPDATES = [
  { time: "2026-10-04T02:20:35.241Z", text: "178湖左岸 06学妹苏州🐝 🎬" },
  { time: "2026-10-04T02:18:16.594Z", text: "苏州 🎬" },
  { time: "2026-09-28T05:59:34.716Z", text: "厦门好闺闺短暂游玩🦜🐝 05/176E 真人 🎬" },
];
let wallUpdates = FALLBACK_UPDATES;

// 会员群活跃提示（2026-10-11 用户要求）：卡片上直接显示「X 小时前有人发言」，
// 一个字的聊天内容都不露。构建时先抓一次拿到时间戳写进 HTML（data-ts），
// 页面打开时由脚本换算成「X 小时前」并刷新一次接口 —— 所以这个时间永远是准的。
let memberActTs = 0;
try {
  const acM = new AbortController();
  const tM = setTimeout(() => acM.abort(), 4000);
  const resM = await fetch("https://chat.waiwei.top/api/member-preview", {
    signal: acM.signal,
    cache: "no-store",
  });
  clearTimeout(tM);
  if (resM.ok) {
    const dM = await resM.json();
    if (dM && dM.lastTime) memberActTs = Number(dM.lastTime) || 0;
    // 兼容旧结构（服务端未更新的那几天仍回 {items:[{time}]}）
    else if (dM && Array.isArray(dM.items) && dM.items.length) memberActTs = Number(dM.items[0].time) || 0;
  }
} catch (e) {
  // 抓不到就不显示时间（卡片上仍留「· 有人发言」）
}
// 「最近更新」文字钩子（2026-10-18 用户要求：上锁帖也要能预览出前两行）。
// 说明：/api/wall-updates 目前对上锁帖只回「🔒 会员内容 📷」，等于钩子失效；
// 而资源墙自己在用的 /api/posts 会对所有访客下发「前两行预览」（postPreviewText，
// 2026-10-11 定的口径，资源墙当天起就免密码了）。两边口径不一致 → 这里改走 /api/posts。
// 拿不到就退回 /api/wall-updates，再拿不到就用内置快照 FALLBACK_UPDATES。
function hookText(p: any) {
  const raw = String((p && p.text) || "");
  const media = Array.isArray(p && p.media) ? p.media : [];
  const video = media.some((m: any) => m && m.type === "video") || !!(p && p.video);
  const img = media.some((m: any) => m && m.type === "image") || !!(p && p.image);
  const hasMedia = video || img || !!(p && p.hasMedia);
  // 空行不算行，最多两行；行内多空格压平
  const t = raw
    .split("\n")
    .map((s: string) => s.replace(/\s+/g, " ").trim())
    .filter(Boolean)
    .slice(0, 2)
    .join("\n");
  // 2026-10-18 用户要求：只有图/视频、没写正文的帖子，外面就显示「会员专享」四个字
  if (!t) return "会员专享";
  return video ? t + " 🎬" : hasMedia ? t + " 📷" : t;
}
try {
  const ac = new AbortController();
  const t = setTimeout(() => ac.abort(), 4000);
  const res = await fetch("https://chat.waiwei.top/api/posts", {
    signal: ac.signal,
    cache: "no-store",
  });
  clearTimeout(t);
  if (res.ok) {
    const data = await res.json();
    const arr = Array.isArray(data) ? data : data && Array.isArray(data.items) ? data.items : [];
    if (arr.length) {
      wallUpdates = arr.slice(0, 3).map((p: any) => ({ time: p && p.time, text: hookText(p) }));
    }
  }
} catch (e) {
  try {
    const ac2 = new AbortController();
    const t2 = setTimeout(() => ac2.abort(), 4000);
    const res2 = await fetch("https://chat.waiwei.top/api/wall-updates", {
      signal: ac2.signal,
      cache: "no-store",
    });
    clearTimeout(t2);
    if (res2.ok) {
      const d2 = await res2.json();
      if (d2 && Array.isArray(d2.items) && d2.items.length) wallUpdates = d2.items.slice(0, 3);
    }
  } catch (e2) {
    // 两次都抓不到 → 保持 FALLBACK_UPDATES
  }
}
// 会员群活跃提示的构建时文案（页面打开后由脚本按当前时刻刷新，所以永远准；
// 这样即使脚本还没跑/被禁用，卡片上也是有时间的，不会只剩「· 有人发言」）
function fmtAgoBuild(ts: number) {
  if (!ts) return "";
  const diff = Math.max(0, (Date.now() - ts) / 1000);
  if (diff < 60) return "刚刚";
  if (diff < 3600) return Math.floor(diff / 60) + "分钟前";
  if (diff < 86400) return Math.floor(diff / 3600) + "小时前";
  return Math.floor(diff / 86400) + "天前";
}
const memberActLabel = fmtAgoBuild(memberActTs);

// 构建时用的日期（按北京时间，和访客看到的"最近更新 10月4日"口径一致）
function fmtBeijing(iso: string) {
  const d = new Date(iso);
  if (!iso || isNaN(d.getTime())) return "";
  const bj = new Date(d.getTime() + 8 * 3600 * 1000);
  return bj.getUTCMonth() + 1 + "月" + bj.getUTCDate() + "日";
}
const wallNewestLabel = fmtBeijing(wallUpdates[0] && wallUpdates[0].time);
---

  <div class="hall">

    <!-- 资源墙：深墨主卡（素雅体系里唯一的深色锚点） -->
    <a href={HALL.wall} class="hall-wall">
