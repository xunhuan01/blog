</style>

<script>
  // 资源墙「最近更新」：页面里已经有构建时写死的最近 3 条（永远可见），
  // 这里只是拉一次接口把它刷新成最新的（2026-10-04 改：拉不到就保持原样，绝不再整块隐藏）
  (function () {
    const API = "https://chat.waiwei.top/api/wall-updates";
    const wrap = document.getElementById("wall-updates");
    const head = document.getElementById("wall-updates-head");
    const listEl = document.getElementById("wall-updates-list");
    const chip = document.getElementById("wall-new-chip");
    if (!wrap || !head || !listEl || !chip) return;

    function esc(s) {
      return String(s == null ? "" : s)
        .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
    }
    function fmt(iso) {
      const d = new Date(iso);
      if (!iso || isNaN(d.getTime())) return "";
      const diff = (Date.now() - d.getTime()) / 1000;
      if (diff < 60) return "刚刚";
      if (diff < 3600) return Math.floor(diff / 60) + "分钟前";
      if (diff < 86400) return Math.floor(diff / 3600) + "小时前";
      const m = (d.getMonth() + 1) + "月" + d.getDate() + "日";
      return d.getFullYear() === new Date().getFullYear() ? m : d.getFullYear() + "年" + m;
    }

    fetch(API, { cache: "no-store" })
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (!d || !d.count || !Array.isArray(d.items) || !d.items.length) return;
        const newest = (d.items[0] && d.items[0].time) || d.last;
        let seen = null;
        try { seen = localStorage.getItem("wall_seen"); } catch (e) {}
        // 首次访问：按"这几条都算新"展示；之后：只数比上次看到的时间更新的
        const fresh = seen ? d.items.filter((i) => i.time && i.time > seen).length : d.items.length;
        try { if (newest) localStorage.setItem("wall_seen", newest); } catch (e) {}

        head.textContent = "↻ 最近更新 " + fmt(newest);
        // 2026-10-18：不再整体重画 innerHTML —— 那样会丢掉行首的图片图标，
        // 也会把构建时从 /api/posts 抓到的真钩子又盖回「🔒 会员内容」。
        // 改法：只把「不是 🔒 占位符」的文字刷进已有的 .hall-upd__tx 里。
        const REDACTED = /^\s*🔒/;
        const txEls = listEl.querySelectorAll(".hall-upd__tx");
        d.items.forEach((i, idx) => {
          const el = txEls[idx];
          if (!el) return;
          const txt = String((i && i.text) || "");
          if (txt && !REDACTED.test(txt)) el.textContent = txt;
        });
        if (fresh > 0) {
          chip.textContent = fresh + " 条新";
          chip.style.display = "inline-block";
        }
        wrap.style.display = "block";
      })
      .catch(() => {});   // 接口挂了就静默保持原样
  })();

  // 会员群活跃提示（2026-10-11）：卡片上显示「X 小时前有人发言」，不含任何内容
  (function () {
    const el = document.getElementById("member-act");
    if (!el) return;
    function fmtAgo(ts) {
      if (!ts || isNaN(ts)) return "";
      const diff = Math.max(0, (Date.now() - ts) / 1000);
      if (diff < 60) return "刚刚";
      if (diff < 3600) return Math.floor(diff / 60) + "分钟前";
      if (diff < 86400) return Math.floor(diff / 3600) + "小时前";
      return Math.floor(diff / 86400) + "天前";
    }
    function paint(ts) {
      const label = fmtAgo(ts);
      const tEl = document.getElementById("member-act-time");
      const xEl = document.getElementById("member-act-text");
      if (!tEl || !xEl) return;
      tEl.textContent = label ? "· " + label : "";        // 第一行：点 + 时间
      xEl.textContent = label ? "有人发言" : "同好交流";   // 第二行；拿不到数据就退回原副标题
    }
    paint(Number(el.dataset.ts));
    fetch("https://chat.waiwei.top/api/member-preview", { cache: "no-store" })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (d && d.lastTime) paint(Number(d.lastTime));
        else if (d && Array.isArray(d.items) && d.items.length) paint(Number(d.items[0].time));   // 兼容旧结构
      })
      .catch(function () {});
  })();

  // PWA 安装按钮逻辑
  (function () {
    const wrap = document.getElementById("install-wrap");
    const btn = document.getElementById("install-btn");
    if (!wrap || !btn) return;

    // 已安装（独立窗口模式）→ 隐藏按钮
    if (window.matchMedia("(display-mode: standalone)").matches) {
      wrap.style.display = "none";
      return;
    }

    // iOS Safari：不支持系统安装框，点击时提示"添加到主屏幕"
    const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);

    // 浏览器可安装信号（Chrome/Edge 可能不发，有就用，没有也能引导）
    let deferredPrompt = null;
    window.addEventListener("beforeinstallprompt", (e) => {
      e.preventDefault();
      deferredPrompt = e;
    });

    // 2026-10-18：点击绑在**整行**上（原来是绑 #install-btn，那颗按钮只有 16×16，
    // 点「安装到桌面」四个字没反应）。按钮在 wrap 里，点它也会冒泡上来，所以不用绑两次。
    wrap.addEventListener("click", async () => {
      if (isIOS) {
        alert("请点击浏览器底部的「分享」按钮，然后选择「添加到主屏幕」，即可把焦羽放到桌面");
        return;
      }
      if (deferredPrompt) {
        // 有安装资格：弹系统安装框
        deferredPrompt.prompt();
        const choice = await deferredPrompt.userChoice.catch(() => ({}));
        if (choice && choice.outcome === "accepted") {
          wrap.style.display = "none";
        }
        deferredPrompt = null;
        return;
      }
      // 无安装资格（浏览器没发信号）：引导手动安装
      alert("请在浏览器右上角「⋮」菜单中选择「安装应用」/「添加到主屏幕」，即可把焦羽放到桌面");
    });

    window.addEventListener("appinstalled", () => {
      wrap.style.display = "none";
    });
  })();
</script>
