---
// 聊天大厅：微信风格消息列表（浅色模式）
---

<div style="max-width:420px;margin:0 auto;padding-top:12px">

  <!-- 顶栏：居中"聊天"小字 -->
  <div style="position:sticky;top:0;background:#fff;padding:12px 0;text-align:center;font-size:16px;font-weight:600;color:#111;border-bottom:1px solid #f0f0f0;z-index:10">聊天</div>

  <!-- 消息列表（白色） -->
  <div style="background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 1px 6px rgba(0,0,0,0.06)">

    <!-- 资源墙 -->
    <a href="https://chat.waiwei.top/posts" style="display:flex;align-items:center;padding:12px 16px;text-decoration:none;border-bottom:1px solid #f0f0f0;transition:background 0.15s" onmouseover="this.style.background='#f7f7f7'" onmouseout="this.style.background='transparent'">
      <span style="width:46px;height:46px;border-radius:50%;background:#f0f0f0;display:flex;align-items:center;justify-content:center;font-size:22px;margin-right:12px;flex-shrink:0">📢</span>
      <span style="flex:1;min-width:0">
        <span style="display:flex;align-items:center;gap:6px">
          <span style="font-size:16px;font-weight:600;color:#111;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">资源墙</span>
        </span>
        <span style="display:block;font-size:12px;color:#999;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">定期分享，各类资源</span>
      </span>
      <span style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0;margin-left:8px">
        <span style="font-size:10px;color:#fff;background:#fa5151;border-radius:4px;padding:1px 5px;flex-shrink:0">会员</span>
        <span style="font-size:11px;color:#bbb">昨天</span>
      </span>
    </a>

    <!-- 会员群 -->
    <a href="https://chat.waiwei.top/member" style="display:flex;align-items:center;padding:12px 16px;text-decoration:none;border-bottom:1px solid #f0f0f0;transition:background 0.15s" onmouseover="this.style.background='#f7f7f7'" onmouseout="this.style.background='transparent'">
      <span style="width:46px;height:46px;border-radius:50%;background:#f0f0f0;display:flex;align-items:center;justify-content:center;font-size:22px;margin-right:12px;flex-shrink:0">👑</span>
      <span style="flex:1;min-width:0">
        <span style="display:flex;align-items:center;gap:6px">
          <span style="font-size:16px;font-weight:600;color:#111;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">会员群</span>
        </span>
        <span style="display:block;font-size:12px;color:#999;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">密码进入 · 会员互聊</span>
      </span>
      <span style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0;margin-left:8px">
        <span style="font-size:10px;color:#fff;background:#fa5151;border-radius:4px;padding:1px 5px;flex-shrink:0">会员</span>
        <span style="font-size:11px;color:#bbb">15:30</span>
      </span>
    </a>

    <!-- 私聊焦羽（最下面） -->
    <a href="https://chat.waiwei.top/" style="display:flex;align-items:center;padding:12px 16px;text-decoration:none;transition:background 0.15s" onmouseover="this.style.background='#f7f7f7'" onmouseout="this.style.background='transparent'">
      <span style="width:46px;height:46px;border-radius:50%;background:#f0f0f0;display:flex;align-items:center;justify-content:center;font-size:22px;margin-right:12px;flex-shrink:0">💬</span>
      <span style="flex:1;min-width:0">
        <span style="display:flex;align-items:center;gap:6px">
          <span style="font-size:16px;font-weight:600;color:#111;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">私聊焦羽</span>
        </span>
        <span style="display:block;font-size:12px;color:#999;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">一对一私聊</span>
      </span>
      <span style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0;margin-left:8px">
        <span style="font-size:11px;color:#bbb">昨天</span>
      </span>
    </a>

  </div>

  <!-- 安装到桌面（PWA，简约设计） -->
  <div id="install-wrap" style="display:flex;flex-direction:column;align-items:center;gap:10px;margin:17vh auto 0">
    <button id="install-btn" title="安装到桌面" style="width:54px;height:54px;border:none;border-radius:50%;background:linear-gradient(135deg,#07c160,#06ad56);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px rgba(7,193,96,0.28);transition:transform 0.15s">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
    </button>
    <span style="font-size:11px;color:#999;letter-spacing:0.5px">安装到桌面</span>
  </div>

</div>

<script>
  // PWA 安装按钮逻辑
  (function () {
    const wrap = document.getElementById("install-wrap");
    const btn = document.getElementById("install-btn");
    if (!wrap || !btn) return;

    // 已安装（独立窗口模式）→ 隐藏按钮
    if (window.matchMedia("(display-mode: standalone)").matches) {
      wrap.style.display = "none";
      return;
    }

    // iOS Safari：不支持系统安装框，点击时提示"添加到主屏幕"
    const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);

    // 浏览器可安装信号（Chrome/Edge 可能不发，有就用，没有也能引导）
    let deferredPrompt = null;
    window.addEventListener("beforeinstallprompt", (e) => {
      e.preventDefault();
      deferredPrompt = e;
    });

    btn.addEventListener("click", async () => {
      if (isIOS) {
        alert("请点击浏览器底部的「分享」按钮，然后选择「添加到主屏幕」，即可把焦羽放到桌面");
        return;
      }
      if (deferredPrompt) {
        // 有安装资格：弹系统安装框
        deferredPrompt.prompt();
        const choice = await deferredPrompt.userChoice.catch(() => ({}));
        if (choice && choice.outcome === "accepted") {
          wrap.style.display = "none";
        }
        deferredPrompt = null;
        return;
      }
      // 无安装资格（浏览器没发信号）：引导手动安装
      alert("请在浏览器右上角「⋮」菜单中选择「安装应用」/「添加到主屏幕」，即可把焦羽放到桌面");
    });

    window.addEventListener("appinstalled", () => {
      wrap.style.display = "none";
    });
  })();
</script>
