---
// 会员三档（共用组件）：purchase.astro 独立页 与 首页 #purchase-panel 共用，改一处两边生效
// 2026-10-18 改版：换成「6Z 纸感极简 · 清单式」
//   · 三档彻底等权（无卡片、无角标、无主推），整行可选中
//   · 底部一个「开通」，跟随选中档跳对应链接
//   · 选中钻石时按钮变金色、文案变「服务介绍」，跳 /通往性自由之路
//   · 钻石档左上角挂「限购 500 份」红签
//   · 文案按用户逐条确认：黄金第二行「定金，安排外围找客服私聊」；钻石只留《通往性自由之路》
// 2026-10-18 傍晚（用户点名）：
//   · 青铜/黄金的购买链接从快发卡换成酷发卡（kufaka.com/item/…，我们自己建的三个商品）
//   · 「怎么选？」第三行文案「想安排外围就可以了」→「想安排外围」
//   · 「先问客服」从站内 /about/ 改成直接进线路一聊天室（与 ChatHall 的 chat1 同一个地址）
const tiers = [
  {
    id: "bronze",
    name: "青铜会员",
    price: "199",
    desc: ["解锁资源墙 · 会员群 · 付费文章"],
    href: "https://www.kufaka.com/item/gx7eky",   // 快发卡 → 酷发卡（2026-10-18）
    cta: "开通",
    gold: false,
    limit: "",
  },
  {
    id: "gold",
    name: "黄金会员",
    price: "499",
    desc: ["含青铜会员全部权益", "定金，安排外围找客服私聊"],
    href: "https://www.kufaka.com/item/dczf9x",   // 快发卡 → 酷发卡（2026-10-18）
    cta: "开通",
    gold: false,
    limit: "",
  },
  {
    id: "diamond",
    name: "钻石会员",
    price: "6999",
    desc: ["含黄金会员全部权益", "《通往性自由之路》"],
    href: "/通往性自由之路",
    cta: "服务介绍",
    gold: true,
    limit: "限购 500 份",
  },
];

const first = tiers[0];
---

<div class="buy">
  <div class="buy-head">
    <div class="buy-kick">Membership</div>
    <h2 class="buy-title">会员</h2>
    <div class="buy-sub">长期有效</div>
    <div class="buy-hr"></div>
  </div>

  {
    tiers.map((tier, i) => (
      <label
        class:list={["buy-item", i === 0 ? "on" : ""]}
        data-href={tier.href}
        data-cta={tier.cta}
        data-gold={tier.gold ? "1" : "0"}
      >
        <input type="radio" name="buy-tier" checked={i === 0} />
        {tier.limit && <span class="buy-limit">{tier.limit}</span>}
        <span class="buy-row">
          <span class="buy-name">{tier.name}</span>
          <span class="buy-price">
            <span class="cur">¥</span>
            {tier.price}
          </span>
        </span>
        {tier.desc.map(d => (
          <span class="buy-desc">{d}</span>
        ))}
      </label>
    ))
  }

  <a class="buy-cta" id="buy-cta" href={first.href}>{first.cta}</a>

  <div class="buy-howto">
    <b>怎么选？</b>
    只想看资源 → <em>青铜 ¥199</em><br />
    想安排外围 → <em>黄金 ¥499</em><br />
    想系统了解这一行 → <em>钻石 ¥6999</em>
  </div>

  <div class="buy-ask">有疑问 <a href="https://139.224.1.54:9443/">先问客服</a></div>
</div>

<script>
  // 三档可选 → 底部按钮跟随（钻石：金色 ＋「服务介绍」）
  // ClientRouter 每次导航后会重新挂载，所以绑在 astro:page-load 上
  function initBuyTiers() {
    const items = document.querySelectorAll(".buy-item");
    const cta = document.getElementById("buy-cta");
    if (!items.length || !cta) return;

    items.forEach(function (el) {
      el.addEventListener("click", function () {
        items.forEach(function (i) {
          i.classList.remove("on");
        });
        el.classList.add("on");

        const input = el.querySelector("input");
        if (input) input.checked = true;

        const href = el.getAttribute("data-href") || "";
        cta.setAttribute("href", href);
        cta.textContent = el.getAttribute("data-cta") || "开通";

        if (el.getAttribute("data-gold") === "1") cta.classList.add("gold");
        else cta.classList.remove("gold");

        if (href.indexOf("http") === 0) {
          cta.setAttribute("target", "_blank");
          cta.setAttribute("rel", "noopener");
        } else {
          cta.removeAttribute("target");
          cta.removeAttribute("rel");
        }
      });
    });
  }

  initBuyTiers();
  document.addEventListener("astro:page-load", initBuyTiers);
</script>

<style>
  /* 6Z 纸感极简 · 清单式（2026-10-18）
     素雅黑白灰，层次靠明度；全站唯一点缀色 --gold 只用于「限购」这类小标 */
  .buy {
    padding: 26px 24px 22px;
  }

  .buy-head {
    margin-bottom: 4px;
  }
  .buy-kick {
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #b3ada4;
  }
  .buy-title {
    margin: 10px 0 0;
    font-family: Georgia, "Songti SC", "SimSun", serif;
    font-size: 26px;
    line-height: 1.25;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #171614;
  }
  .buy-sub {
    margin-top: 6px;
    font-size: 11.5px;
    color: #a8a29a;
  }
  .buy-hr {
    height: 1px;
    background: #efebe6;
    margin: 22px 0 4px;
  }

  /* 可选中行：左侧一道深墨竖条标记当前选择，整行可点 */
  .buy-item {
    position: relative;
    display: block;
    padding: 18px 0 18px 14px;
    border-bottom: 1px solid #f2f2f0;
    cursor: pointer;
    transition: background 0.16s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .buy-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 16px;
    bottom: 16px;
    width: 3px;
    border-radius: 2px;
    background: transparent;
    transition: background 0.16s ease;
  }
  .buy-item:last-of-type {
    border-bottom: 0;
  }
  .buy-item.on {
    background: linear-gradient(
      90deg,
      rgba(154, 138, 104, 0.07) 0%,
      rgba(154, 138, 104, 0) 74%
    );
  }
  .buy-item.on::before {
    background: #1c1c1b;
  }
  .buy-item input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .buy-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .buy-name {
    font-size: 16px;
    font-weight: 600;
    color: #1c1b19;
    letter-spacing: 0.01em;
  }
  .buy-price {
    flex-shrink: 0;
    padding-left: 12px;
    font-family: Georgia, "Songti SC", "SimSun", serif;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #1c1b19;
    white-space: nowrap;
  }
  .buy-price .cur {
    font-size: 12px;
    color: #9c968e;
    margin-right: 1px;
  }
  .buy-desc {
    display: block;
    margin-top: 5px;
    font-size: 11px;
    line-height: 1.7;
    color: #aaa49c;
  }

  /* 限购红签：实底白字，挂在行首上方 */
  .buy-limit {
    display: inline-block;
    margin-bottom: 8px;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.06em;
    color: #fff;
    background: #d0453f;
    border-radius: 4px;
    padding: 3px 8px;
  }

  /* 底部按钮：三档共用「开通」；选中钻石时加 .gold 变金色 + 文案「服务介绍」 */
  .buy-cta {
    display: block;
    margin-top: 24px;
    padding: 14px;
    text-align: center;
    background: #1c1c1b;
    color: #fff;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition:
      background 0.16s ease,
      box-shadow 0.16s ease;
  }
  .buy-cta:active {
    opacity: 0.88;
  }
  .buy-cta.gold {
    background: #9a7a26;
    box-shadow: 0 3px 12px rgba(154, 122, 38, 0.26);
  }

  .buy-howto {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid #f2f2f0;
    font-size: 11.5px;
    line-height: 2;
    color: #a29c94;
  }
  .buy-howto b {
    display: block;
    margin-bottom: 4px;
    font-size: 12px;
    font-weight: 600;
    color: #6b665f;
  }
  .buy-howto em {
    font-style: normal;
    font-weight: 600;
    color: #8a6a1f;
  }

  .buy-ask {
    margin-top: 18px;
    text-align: center;
    font-size: 11.5px;
    color: #a8a49f;
  }
  .buy-ask a {
    color: #6b665f;
    font-weight: 600;
    border-bottom: 1px solid #dcdcd9;
    text-decoration: none;
  }

  @media (min-width: 700px) {
    .buy {
      padding: 34px 26px 28px;
    }
    .buy-title {
      font-size: 30px;
    }
    .buy-item {
      padding: 20px 0 20px 16px;
    }
  }
</style>
