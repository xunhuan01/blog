---
// 会员三档卡片（共用组件）：purchase.astro 独立页 与 首页 #purchase-panel 共用，改一处两边生效
// 2026-09-21 第二次改版：间距放松、字号拉开层次（用户要求"中间再稀疏一点、字的大小有不同"）
const BUY_URL = "https://www.kuaifaka.net/purchasing?link=zXKgv3"; // 备用默认

const tiers = [
  {
    id: "bronze",
    icon: "🖤",
    iconHtml: '<svg viewBox="0 0 24 24" width="28" height="28"><rect x="10.6" y="3.5" width="2.8" height="3" rx="1.4" fill="#333"/><circle cx="12" cy="14.5" r="7.5" fill="#333"/><circle cx="12" cy="14.5" r="5.4" fill="none" stroke="#555" stroke-width="1"/><path d="M12 11.2l.85 1.72 1.9.28-1.38 1.34.33 1.9-1.7-.9-1.7.9.33-1.9-1.38-1.34 1.9-.28z" fill="#fff"/></svg>',
    name: "青铜会员",
    level: "基础档",
    price: "¥199",
    buyUrl: "https://m.kuaifaka.net/shop/4eQNQ28G",
    benefits: [
      "解锁资源墙",
      "解锁会员群",
      "解锁付费文章",
    ],
    btnText: "开通青铜会员",
    highlight: false,
  },
  {
    id: "gold",
    icon: "🥇",
    iconHtml: '<svg viewBox="0 0 24 24" width="28" height="28"><circle cx="12" cy="12" r="11" fill="#d4a017"/><text x="12" y="16" text-anchor="middle" font-size="10" fill="#fff" font-weight="700">金</text></svg>',
    name: "黄金会员",
    level: "进阶档",
    price: "¥499",
    buyUrl: "https://m.kuaifaka.net/shop/Rlup63",
    benefits: [
      "含青铜会员全部权益",
      "会费可抵后续安排的消费",
    ],
    btnText: "开通黄金会员",
    highlight: false,
  },
  {
    id: "diamond",
    icon: "💎",
    iconHtml: "",
    name: "钻石会员",
    level: "顶配档",
    price: "¥6999",
    buyText: "购买请联系客服微信：xunhuan314",
    buyNote: "备注：自由之路",
    linkText: "服务介绍",
    benefits: [
      "含黄金会员全部权益",
      "解锁《通往性自由之路》",
    ],
    btnText: "开通钻石会员",
    highlight: false,
  },
];
---

{tiers.map(tier => (
  <div style={`background:#fff;border-radius:16px;padding:20px;margin-bottom:8px;box-shadow:0 2px 12px rgba(0,0,0,0.05);border:1px solid #f0f0f0;`}>
    {/* 第一层：图标 + 档名 …… 价格（价格用最大字号，方便竖着比价） */}
    <div style="display:flex;align-items:center;justify-content:space-between">
      <div style="display:flex;align-items:center;gap:10px">
        <span style="font-size:26px;line-height:1;display:flex">{tier.iconHtml ? <span set:html={tier.iconHtml} /> : tier.icon}</span>
        <div style="font-size:17px;font-weight:700;color:#222">{tier.name}</div>
      </div>
      <div style="font-size:26px;font-weight:800;color:#e74c3c;letter-spacing:-0.5px">{tier.price}</div>
    </div>

    {/* 第二层：权益（13px 小字，行距放松） */}
    <ul style="list-style:none;margin:16px 0 0;padding:0">
      {tier.benefits.map(b => (
        <li style="font-size:13px;color:#666;line-height:1.95;padding-left:2px">
          <span style="color:#22c55e;margin-right:7px">✓</span>{b}
        </li>
      ))}
    </ul>

    {/* 第三层：按钮（上方一条极淡的分隔线，层次更清楚）
        2026-09-21：页面标题「👑 会员购买」已按用户要求删除，卡片整体上提；
        钻石档改为——按钮=「服务介绍」（跳 /通往性自由之路），客服微信那句话挪到按钮下方的备注行 */}
    <div style="border-top:1px solid #f4f4f4;margin-top:16px;padding-top:14px">
      {tier.buyText ? (
        <>
          <a
            href="/通往性自由之路"
            style={`display:block;text-align:center;padding:13px;border-radius:12px;font-size:15px;font-weight:600;background:#555;color:#fff;text-decoration:none;cursor:pointer;`}
          >
            {tier.linkText || "服务介绍"}
          </a>
          <div style="text-align:center;font-size:12px;color:#999;margin-top:9px;line-height:1.6">{tier.buyText}</div>
          {tier.buyNote && (
            <div style="text-align:center;font-size:11px;color:#bbb;margin-top:3px">{tier.buyNote}</div>
          )}
        </>
      ) : (
        <a
          href={tier.buyUrl || BUY_URL}
          style={`display:block;text-align:center;padding:13px;border-radius:12px;text-decoration:none;font-size:15px;font-weight:600;background:#555;color:#fff;`}
        >
          {tier.btnText}
        </a>
      )}
    </div>
  </div>
))}
